<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Overlay pet (TYPE_APPLICATION_OVERLAY). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- On-device STT after the user taps the pet. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Overlay FGS (mic + TTS) and optional break-reminder monitor. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- First-run model download. Chat stays on-device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Soft break reminders based on continuous foreground time in a watched app. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Package visibility without QUERY_ALL_PACKAGES (Play-restricted).
      MAIN/LAUNCHER covers the break-reminder app picker; explicit packages
      cover [open:…] tool tags in AppLauncher.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <package android:name="com.android.browser" />
        <package android:name="com.android.calculator2" />
        <package android:name="com.android.calendar" />
        <package android:name="com.android.camera" />
        <package android:name="com.android.camera2" />
        <package android:name="com.android.chrome" />
        <package android:name="com.android.deskclock" />
        <package android:name="com.android.dialer" />
        <package android:name="com.android.email" />
        <package android:name="com.android.gallery3d" />
        <package android:name="com.android.mms" />
        <package android:name="com.android.settings" />
        <package android:name="com.android.vending" />
        <package android:name="com.brave.browser" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.google.android.GoogleCamera" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.google.android.apps.photos" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.calculator" />
        <package android:name="com.google.android.calendar" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.google.android.dialer" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="com.miui.calculator" />
        <package android:name="com.miui.gallery" />
        <package android:name="com.opera.browser" />
        <package android:name="com.samsung.android.calendar" />
        <package android:name="com.samsung.android.camera" />
        <package android:name="com.samsung.android.dialer" />
        <package android:name="com.samsung.android.email.provider" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.sec.android.app.popupcalculator" />
        <package android:name="com.sec.android.gallery3d" />
        <package android:name="com.spotify.music" />
        <package android:name="com.waze" />
        <package android:name="org.mozilla.firefox" />
    </queries>

    <application
        android:name=".KawaiiPetApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KawaiiPet"
        tools:targetApi="35">

        <!-- LiteRT-LM GPU backend (optional libs) -->
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <activity
            android:name=".ui.PetStartTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoDisplay" />

        <activity
            android:name=".ui.AiTriggerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.KawaiiPet.AiForegroundGate" />

        <activity
            android:name=".ui.AiForegroundGateActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.KawaiiPet.AiForegroundGate" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.KawaiiPet">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".overlay.PetOverlayService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <service
            android:name=".usage.UsageReminderService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors continuous app usage to gently nudge the user via the pet overlay" />
        </service>

        <service
            android:name=".overlay.StartPetTileService"
            android:exported="true"
            android:icon="@drawable/ic_pet_notification"
            android:label="@string/tile_start_pet_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
